# API key for the TypeSafe Jev decision model.
# Get one at https://typesafe.ai
# When unset, the project falls back to the deterministic mock provider (JEV_PROVIDER=mock),
# so the full suite stays runnable offline and in CI without credentials.
TYPESAFE_API_KEY=

# Optional overrides
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
